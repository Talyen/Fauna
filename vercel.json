{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "git": { "deploymentEnabled": false },
  "installCommand": "npm install --global npm@12.2.1 --ignore-scripts --no-audit --no-fund && ELECTRON_SKIP_BINARY_DOWNLOAD=1 npm ci --no-audit --no-fund",
  "buildCommand": "node scripts/release/vercel-build.mjs",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/prepared/objects/:path*",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ],
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}
