{
  "name": "fauna",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:desktop": "node scripts/preview.mjs --desktop",
    "check": "node scripts/check.mjs",
    "check:full": "tsc --noEmit && oxlint src tests scripts desktop design --deny-warnings && prettier --check . && node scripts/boundaries.mjs && node scripts/ui-contract.mjs",
    "format": "prettier --write .",
    "test": "node scripts/run-local-tests.mjs",
    "test:full": "vitest run",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:e2e": "playwright test",
    "test:desktop": "node scripts/smoke-desktop.mjs",
    "package:win": "npm run build && electron-builder --win --x64 --dir",
    "verify": "node scripts/check.mjs",
    "verify:full": "npm run check:full && npm run content:audit && npm run test:full && npm run build && npm run test:e2e",
    "task:create": "node scripts/worktree.mjs",
    "preview:task": "node scripts/preview.mjs",
    "assets:prepare": "node scripts/assets.mjs --prepare",
    "assets:check": "node scripts/assets.mjs --sources",
    "assets:check:outputs": "node scripts/assets.mjs --outputs",
    "content:audit": "node scripts/content-audit.mjs",
    "balance:playthrough": "node scripts/run-playthrough.mjs",
    "predev": "npm run assets:check:outputs",
    "prebuild": "npm run assets:check:outputs",
    "audio:review": "node scripts/audio-review.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "immer": "11.1.8",
    "lucide-react": "^1.59.0",
    "motion": "12.38.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "tailwind-merge": "^3.7.0",
    "zod": "4.4.3",
    "zustand": "5.0.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "jsdom": "^29.1.1",
    "oxlint": "1.87.0",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.3.0",
    "typescript": "7.0.2",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  },
  "build": {
    "appId": "com.fauna.game",
    "productName": "Fauna",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
