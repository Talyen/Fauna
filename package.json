{
  "name": "fauna",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:desktop": "node scripts/dev-desktop.mjs",
    "check": "tsc --noEmit && oxlint src tests scripts desktop --deny-warnings && prettier --check . && node scripts/boundaries.mjs",
    "format": "prettier --write .",
    "test": "vitest run",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:e2e": "playwright test",
    "test:desktop": "node scripts/smoke-desktop.mjs",
    "package:win": "npm run build && electron-builder --win --x64 --dir",
    "verify": "npm run check && npm test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "immer": "11.1.8",
    "zustand": "5.0.13",
    "zod": "4.4.3",
    "motion": "12.38.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@tailwindcss/vite": "^4.3.0",
    "tailwindcss": "^4.3.0",
    "vite": "^8.0.10",
    "typescript": "7.0.2",
    "vitest": "^4.1.5",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@testing-library/jest-dom": "^6.9.1",
    "jsdom": "^29.1.1",
    "@playwright/test": "^1.60.0",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "oxlint": "1.87.0",
    "prettier": "^3.8.3"
  },
  "build": {
    "appId": "com.fauna.game",
    "productName": "Fauna",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
