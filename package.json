{
  "name": "fauna",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=12.2.1 <13"
  },
  "scripts": {
    "dev": "node scripts/dev/dev.mjs",
    "dev:desktop": "node scripts/dev/dev-desktop.mjs",
    "check": "npm run check:full",
    "check:full": "node scripts/local.mjs check:full",
    "format": "prettier --write .",
    "test": "node scripts/local.mjs test",
    "test:smoke": "node scripts/checks/run-local-tests.mjs",
    "test:full": "node scripts/local.mjs test",
    "build": "node scripts/local.mjs build",
    "preview": "vite preview --host 127.0.0.1",
    "test:e2e": "node scripts/local.mjs test:e2e",
    "test:desktop": "node scripts/release/smoke-desktop.mjs",
    "package:win": "npm run build && npm run check:bundle && npm run assets:check:bundle && electron-builder --win --x64 --dir --publish never",
    "verify": "node scripts/local.mjs verify:changed",
    "verify:changed": "node scripts/local.mjs verify:changed",
    "verify:full": "node scripts/local.mjs verify:full",
    "worktree": "node scripts/worktree.mjs",
    "integrate": "node scripts/local.mjs integrate",
    "deps": "node scripts/dependencies.mjs",
    "worktree:cleanup": "node scripts/worktree-cleanup.mjs",
    "docs:check": "node scripts/checks/check-docs.mjs",
    "check:bundle": "node scripts/checks/check-bundle-budget.mjs",
    "preview:task": "node scripts/dev/preview.mjs",
    "capture:task": "node scripts/dev/capture.mjs",
    "assets:prepare": "node scripts/assets/assets.mjs --prepare",
    "assets:check": "node scripts/assets/assets.mjs --sources",
    "assets:check:outputs": "node scripts/assets/assets.mjs --outputs",
    "content:audit": "node scripts/checks/content-audit.mjs",
    "balance:playthrough": "node scripts/balance/run-playthrough.mjs",
    "predev": "npm run assets:check:outputs",
    "prebuild": "npm run assets:check:outputs",
    "audio:review": "node scripts/assets/audio-review.mjs",
    "context": "node scripts/agent/agent-context.mjs",
    "investigate": "node scripts/agent/investigate.mjs",
    "review:status": "node scripts/agent/agent-review.mjs --status",
    "review:diff": "node scripts/agent/agent-review.mjs",
    "verify:package": "node scripts/release/verify-package.mjs",
    "balance:compare": "node scripts/balance/balance-compare.mjs",
    "perf": "node scripts/performance/run-performance.mjs",
    "perf:replay": "node scripts/performance/run-performance.mjs replay",
    "perf:compare": "node scripts/performance/run-performance.mjs compare",
    "test:e2e:route": "node scripts/performance/test-route.mjs",
    "test:interactions": "node scripts/performance/run-interactions.mjs",
    "deadcode": "node scripts/local.mjs deadcode",
    "balance:findings": "node scripts/balance/balance-findings.mjs",
    "verify:release-version": "node scripts/release/verify-release.mjs --version-only",
    "verify:release": "node scripts/release/verify-release.mjs",
    "generate:patch-notes": "node scripts/release/generate-patch-notes.mjs",
    "assets:check:bundle": "node scripts/assets/active-assets.mjs",
    "assets:review": "node scripts/assets/art-review.mjs",
    "check:types": "node scripts/local.mjs check:types",
    "security:audit": "node scripts/checks/security-audit.mjs",
    "package:installer": "npm run build && npm run check:bundle && npm run assets:check:bundle && electron-builder --win --x64 --publish never",
    "check:lint": "node scripts/local.mjs check:lint",
    "check:format": "node scripts/local.mjs check:format",
    "check:boundaries": "node scripts/local.mjs check:boundaries",
    "generate:release-inventory": "node scripts/release/dependency-inventory.mjs",
    "finish": "node scripts/local.mjs integrate"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "immer": "11.2.7",
    "lucide-react": "^1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "steamworks.js": "0.4.0",
    "tailwind-merge": "^3.7.0",
    "zod": "4.6.7",
    "zustand": "5.0.16",
    "koffi": "3.3.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@electron/asar": "^4.3.1",
    "@electron/fuses": "2.1.3",
    "@playwright/test": "^1.64.1",
    "@rolldown/plugin-babel": "0.2.4",
    "@swc/core": "1.16.18",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "1.0.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "fs-native-extensions": "1.5.2",
    "jsdom": "^30.1.3",
    "knip": "6.42.1",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2004",
    "postcss": "8.5.31",
    "prettier": "^3.9.10",
    "sharp": "0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "build": {
    "appId": "com.fauna.game",
    "productName": "Fauna",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "package.json",
      "src/game/save-format.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "afterPack": "desktop/after-pack.cjs",
    "asarUnpack": [
      "**/node_modules/steamworks.js/**/*",
      "**/node_modules/koffi/**/*",
      "**/node_modules/@koromix/koffi-*/**/*"
    ],
    "npmRebuild": false
  },
  "allowScripts": {
    "@swc/core@1.16.18": true,
    "electron-winstaller@5.4.0": true,
    "fsevents@2.3.3": true,
    "koffi@3.3.3": true
  },
  "packageManager": "npm@12.2.1"
}
